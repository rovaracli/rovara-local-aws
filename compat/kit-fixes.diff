+def _pin_to_endpoint(endpoint):
+    """Some generated inputs (Kinesis StreamId with an odd StreamARN) make botocore's endpoint rules build a
+    real AWS host name and ignore endpoint_url. Rewrite any such request onto the emulator's address so the
+    kit never opens a connection anywhere else."""
+    import urllib.parse
+    target = urllib.parse.urlsplit(endpoint)
+
+    def pin(request, **kw):
+        u = urllib.parse.urlsplit(request.url)
+        if (u.scheme, u.netloc) != (target.scheme, target.netloc):
+            request.url = urllib.parse.urlunsplit((target.scheme, target.netloc, u.path, u.query, u.fragment))
+    return pin
+
+
 def make_client(svc, endpoint, access_key=None, secret_key=None, session_token=None, read_timeout=None):
-    return boto3.client(svc, endpoint_url=endpoint, region_name=REGION,
-                        aws_access_key_id=access_key or FAKE, aws_secret_access_key=secret_key or FAKE,
-                        aws_session_token=session_token, config=make_config(read_timeout))
+    client = boto3.client(svc, endpoint_url=endpoint, region_name=REGION,
+                          aws_access_key_id=access_key or FAKE, aws_secret_access_key=secret_key or FAKE,
+                          aws_session_token=session_token, config=make_config(read_timeout))
+    client.meta.events.register("before-send.*.*", _pin_to_endpoint(endpoint))
+    return client
 
 
